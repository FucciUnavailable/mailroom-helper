# Copy to .env and fill in. Every value below is a placeholder.
# Nothing in this file is a real credential.

# --- Supabase -----------------------------------------------------------
# Service role key: the task writes to messages/threads and reads kb_chunks
# with RLS bypassed. Server-side only, never shipped to a client.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="paste-service-role-key-here"

# --- Anthropic ----------------------------------------------------------
# Classification and the reply agent loop. This is the only model API in the
# stack; retrieval is Postgres full-text search and costs nothing.
ANTHROPIC_API_KEY="sk-ant-paste-key-here"

# --- Resend -------------------------------------------------------------
# Both directions, one key. RESEND_API_KEY signs the outbound send in
# src/lib/notify.ts and the inbound GET /emails/receiving/{id} in
# src/trigger/resend-inbound.ts — the email.received webhook is metadata only,
# so the body and headers need a second, authenticated call.
#
# RESEND_FROM must be an address on a domain you have verified in Resend.
# The shared onboarding@resend.dev sender only delivers to the address on your
# own Resend account, which is not enough once the agent replies to whoever
# wrote in.
RESEND_API_KEY="re_paste-key-here"
RESEND_FROM="Mailroom <sales@your-verified-domain.com>"

# --- Make.com -----------------------------------------------------------
# Scenario C: approval relay. Turns the GET from an approve/reject link into
# the authenticated POST that completes the Trigger.dev waitpoint token.
APPROVAL_RELAY_BASE_URL="https://hook.eu2.make.com/replace-with-your-webhook"

# --- Slack --------------------------------------------------------------
# Incoming webhook. Receives approval requests and escalation notices.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/replace-me"

# --- Trigger.dev --------------------------------------------------------
# TRIGGER_SECRET_KEY is read by the CLI and by scripts/send-sample.ts.
TRIGGER_SECRET_KEY="tr_dev_replace-me"
TRIGGER_PROJECT_REF="proj_replace-me"
